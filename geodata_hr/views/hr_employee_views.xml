<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_employee_form_geodata" model="ir.ui.view">
        <field name="name">hr.employee.form.geodata</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Hidden fields before address block -->
            <xpath expr="//page[@name='personal_information']//label[@for='private_street']" position="before">
                <field name="has_geodata_credential" invisible="True" force_save="1"/>
                <field name="geodata_autocomplete_active" invisible="True" force_save="1"/>
                <field name="geodata_address_id" invisible="True" force_save="1"/>
                <field name="private_country_code" invisible="True"/>
            </xpath>

            <!-- Street autocomplete -->
            <xpath expr="//page[@name='personal_information']//field[@name='private_street']" position="attributes">
                <attribute name="widget">kw_autocomplete</attribute>
                <attribute name="options">{
                    'source_type': 'model_method',
                    'source_config': {
                        'model': 'geodata.api.credential',
                        'method': 'kw_autocomplete_streets'
                    },
                    'depends_on': ['geodata_address_id', 'private_city', 'private_street'],
                    'on_select_method': 'apply_geodata_address',
                    'min_chars': 3
                }</attribute>
            </xpath>

            <!-- City autocomplete -->
            <xpath expr="//page[@name='personal_information']//field[@name='private_city']" position="attributes">
                <attribute name="widget">kw_autocomplete</attribute>
                <attribute name="options">{
                    'source_type': 'model_method',
                    'source_config': {
                        'model': 'geodata.api.credential',
                        'method': 'kw_autocomplete_cities'
                    },
                    'depends_on': ['private_country_id'],
                    'on_select_method': 'apply_geodata_address',
                    'min_chars': 3
                }</attribute>
            </xpath>

            <!-- Area and hromada after state -->
            <xpath expr="//page[@name='personal_information']//field[@name='private_state_id']" position="after">
                <field name="private_area" placeholder="District/Raion"
                       widget="kw_autocomplete"
                       options="{
                           'source_type': 'model_method',
                           'source_config': {
                               'model': 'geodata.api.credential',
                               'method': 'kw_autocomplete_areas'
                           },
                           'min_chars': 3
                       }"
                       invisible="private_country_code != 'UA'"/>
                <field name="private_hromada" placeholder="Hromada"
                       widget="kw_autocomplete"
                       options="{
                           'source_type': 'model_method',
                           'source_config': {
                               'model': 'geodata.api.credential',
                               'method': 'kw_autocomplete_hromadas'
                           },
                           'depends_on': ['private_area'],
                           'min_chars': 3
                       }"
                       invisible="private_country_code != 'UA'"/>
            </xpath>

        </field>
    </record>
</odoo>
