<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Geodata API Credential Form View -->
    <record id="geodata_api_credential_view_form" model="ir.ui.view">
        <field name="name">geodata.api.credential.view.form</field>
        <field name="model">geodata.api.credential</field>
        <field name="arch" type="xml">
            <form string="Geodata.online API Credential">
                <field name="active" invisible="True"/>
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary" icon="fa-plug"/>
                    <button name="action_sync_ukraine_states" string="Sync Ukraine States" type="object" class="btn-secondary" icon="fa-refresh"
                            help="Синхронізувати області України з довідковими даними. Використовуйте при першому налаштуванні або якщо області не відображаються коректно."
                            confirm="Синхронізувати області України з довідковими даними?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="code" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="API Configuration">
                            <group>
                                <group>
                                    <field name="api_connector_id" options="{'no_create': True}" autocomplete="off"/>
                                    <field name="api_username" autocomplete="off"/>
                                    <field name="api_password" password="True" autocomplete="off"/>
                                </group>
                                <group>
                                    <field name="type" readonly="1"/>
                                    <field name="is_log_enabled"/>
                                    <field name="access_token" password="True" readonly="1" groups="base.group_system"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <p>
                                    <strong>How to get API credentials:</strong>
                                </p>
                                <ol>
                                    <li>Visit <a href="https://geodata.online/" target="_blank">geodata.online</a></li>
                                    <li>Register or login to your account</li>
                                    <li>Use your account email and password</li>
                                    <li>Enter credentials in the fields above</li>
                                    <li>Click "Test Connection" to verify and obtain access token</li>
                                </ol>
                                <p class="text-muted">
                                    <small>Access token is automatically refreshed when expired (14 days validity)</small>
                                </p>
                            </div>
                        </page>
                        <page string="Settings">
                            <group>
                                <group string="Транслітерація">
                                    <field name="store_english"
                                           string="Українська транслітерація"
                                           help="Зберігати англійську транслітерацію українських адрес"/>
                                </group>
                            </group>
                            <separator string="Address Format Templates"/>
                            <div class="alert alert-info small" role="alert">
                                <p class="mb-1">
                                    <strong>Шаблони формату адрес для документів та листів.</strong>
                                    Якщо поле порожнє — використовується формат за замовчуванням.
                                    Порожні плейсхолдери автоматично пропускаються разом з роздільниками.
                                </p>
                                <p class="mb-1"><strong>Основні плейсхолдери</strong> (вже містять стару назву в дужках):</p>
                                <p class="mb-0 font-monospace">
                                    <code>{country}</code> — країна,
                                    <code>{index}</code> — індекс,
                                    <code>{region}</code> — область,
                                    <code>{area}</code> — район (зі старою назвою),
                                    <code>{hromada}</code> — громада,
                                    <code>{city}</code> — місто (зі старою назвою),
                                    <code>{street}</code> — вулиця (зі старою назвою),
                                    <code>{house}</code> — будинок,
                                    <code>{apartment}</code> — квартира
                                </p>
                                <p class="mt-2 mb-1"><strong>Окремо старі назви</strong> (для власного форматування):</p>
                                <p class="mb-0 font-monospace">
                                    <code>{region_old}</code>,
                                    <code>{area_old}</code>,
                                    <code>{city_old}</code>,
                                    <code>{street_old}</code>
                                </p>
                                <hr class="my-2"/>
                                <p class="mb-1"><strong>Приклади (можна скопіювати):</strong></p>
                                <p class="mb-0 font-monospace" style="user-select: all; cursor: text;">
                                    {country}, {index}, {region}, {area}, {city}, {street}, {house}<br/>
                                    {country}, {index}, {region}, {area}, {hromada}, {city}, {street}, {house}, {apartment}<br/>
                                    {index}, {city}, {street}, {house}
                                </p>
                            </div>
                            <group>
                                <field name="address_format_document"
                                       string="Format for Documents"
                                       placeholder="{country}, {index}, {region}, {area}, {city}, {street}, {house}"/>
                                <field name="address_format_letter"
                                       string="Format for Letters"
                                       placeholder="{index}, {region}, {area}, {city}, {street}, {house}"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Geodata API Credential Tree View -->
    <record id="geodata_api_credential_view_tree" model="ir.ui.view">
        <field name="name">geodata.api.credential.view.tree</field>
        <field name="model">geodata.api.credential</field>
        <field name="arch" type="xml">
            <list string="Geodata.online API Credentials">
                <field name="name"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Geodata API Credential Search View -->
    <record id="geodata_api_credential_view_search" model="ir.ui.view">
        <field name="name">geodata.api.credential.view.search</field>
        <field name="model">geodata.api.credential</field>
        <field name="arch" type="xml">
            <search string="Search Credentials">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Geodata API Credential Action -->
    <record id="geodata_api_credential_action" model="ir.actions.act_window">
        <field name="name">API Credentials</field>
        <field name="res_model">geodata.api.credential</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Geodata.online API credential
            </p>
            <p>
                Configure API credentials to connect to Geodata.online service.
                You will need your username (email) and password from geodata.online.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_geodata_root"
              name="Geodata.online"
              parent="base.menu_administration"
              sequence="99"
              groups="geodata_connector.group_geodata_manager"/>

    <menuitem id="menu_geodata_api_credential"
              name="Облікові дані API"
              parent="menu_geodata_root"
              action="geodata_api_credential_action"
              sequence="10"/>

</odoo>
