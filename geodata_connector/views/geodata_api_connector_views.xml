<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Geodata API Connector Form View -->
    <record id="geodata_api_connector_view_form" model="ir.ui.view">
        <field name="name">geodata.api.connector.view.form</field>
        <field name="model">geodata.api.connector</field>
        <field name="arch" type="xml">
            <form string="Geodata API Connector">
                <sheet>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="api_url"/>
                        </group>
                        <group>
                            <field name="type" readonly="1"/>
                            <field name="is_api_token_used" readonly="1"/>
                            <field name="is_api_token_static" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Geodata API Connector Tree View -->
    <record id="geodata_api_connector_view_tree" model="ir.ui.view">
        <field name="name">geodata.api.connector.view.tree</field>
        <field name="model">geodata.api.connector</field>
        <field name="arch" type="xml">
            <list string="Geodata API Connectors">
                <field name="name"/>
                <field name="api_url"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <!-- Geodata API Connector Action -->
    <record id="geodata_api_connector_action" model="ir.actions.act_window">
        <field name="name">API Connectors</field>
        <field name="res_model">geodata.api.connector</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_geodata_api_connector"
              name="Конектори API"
              parent="menu_geodata_root"
              action="geodata_api_connector_action"
              sequence="20"
              groups="base.group_system"/>

</odoo>
