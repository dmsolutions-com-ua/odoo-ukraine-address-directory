<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">

        <!-- Geodata User Group -->
        <record id="group_geodata_user" model="res.groups">
            <field name="name">Geodata.online User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Users who can use Geodata address wizard</field>
        </record>

        <!-- Geodata Manager Group -->
        <record id="group_geodata_manager" model="res.groups">
            <field name="name">Geodata.online Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_geodata_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Users who can manage Geodata API credentials and configuration</field>
        </record>

</odoo>
