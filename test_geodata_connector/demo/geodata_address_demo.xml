<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

        <!-- Demo Address: Kyiv, Khreshchatyk -->
        <record id="geodata_address_demo_kyiv" model="geodata.address">
            <field name="geodata_id">1</field>
            <field name="address_string">м. Київ, вул. Хрещатик, 1</field>
            <field name="post_index">01001</field>
            <field name="region">Київська</field>
            <field name="city">Київ</field>
            <field name="settlement_type">місто</field>
            <field name="street">Хрещатик</field>
            <field name="str_type">вул.</field>
            <field name="house_num">1</field>
            <field name="latitude">50.4501</field>
            <field name="longitude">30.5234</field>
            <field name="is_regional_center" eval="True"/>
        </record>

