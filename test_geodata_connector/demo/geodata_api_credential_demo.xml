<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <!-- Demo Geodata API Credential -->
    <record id="geodata_api_credential_demo" model="geodata.api.credential">
        <field name="name">Geodata Demo Credential</field>
        <field name="active" eval="False"/>
        <field name="api_connector_id" ref="geodata_connector.geodata_api_connector_geodata"/>
        <field name="api_username">demo@example.com</field>
        <field name="api_password">demo_password</field>
        <field name="kw_http_request_log_source_id" ref="geodata_connector.kw_http_request_log_source_geodata"/>
        <field name="is_log_enabled" eval="True"/>
    </record>

</odoo>
