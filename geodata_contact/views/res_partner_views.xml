<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_geodata" model="ir.ui.view">
        <field name="name">res.partner.form.geodata</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]" position="before">
                <field name="has_geodata_credential" invisible="True" force_save="1"/>
                <field name="geodata_store_english" invisible="True" force_save="1"/>
                <field name="geodata_store_russian" invisible="True" force_save="1"/>
                <field name="geodata_autocomplete_active" invisible="True" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="widget">kw_autocomplete</attribute>
                <attribute name="options">{
                    'source_type': 'model_method',
                    'source_config': {
                        'model': 'geodata.api.credential',
                        'method': 'kw_autocomplete_streets'
                    },
                    'depends_on': ['geodata_address_id', 'city', 'street'],
                    'on_select_method': 'apply_address_to_partner',
                    'min_chars': 3
                }</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="widget">kw_autocomplete</attribute>
                <attribute name="options">{
                    'source_type': 'model_method',
                    'source_config': {
                        'model': 'geodata.api.credential',
                        'method': 'kw_autocomplete_cities'
                    },
                    'depends_on': ['country_id'],
                    'on_select_method': 'apply_address_to_partner',
                    'min_chars': 3
                }</attribute>
            </xpath>

            <xpath expr="//field[@name='state_id']" position="after">
                <field name="area" placeholder="District/Raion"
                       readonly="1" force_save="1"
                       invisible="country_code != 'UA'"/>
                <field name="hromada" placeholder="Hromada"
                       readonly="1" force_save="1"
                       invisible="country_code != 'UA'"/>
            </xpath>

            <xpath expr="//field[@name='child_ids']/form//div[@name='div_address']" position="before">
                <field name="has_geodata_credential" invisible="True" force_save="1"/>
                <field name="geodata_store_english" invisible="True" force_save="1"/>
                <field name="geodata_store_russian" invisible="True" force_save="1"/>
                <field name="geodata_autocomplete_active" invisible="True" force_save="1"/>
                <field name="geodata_address_id" invisible="True" force_save="1"/>
                <field name="country_code" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='street']" position="attributes">
                <attribute name="widget">kw_autocomplete</attribute>
                <attribute name="options">{
                    'source_type': 'model_method',
                    'source_config': {
                        'model': 'geodata.api.credential',
                        'method': 'kw_autocomplete_streets'
                    },
                    'depends_on': ['geodata_address_id', 'city', 'street'],
                    'on_select_method': 'apply_address_to_partner',
                    'min_chars': 3
                }</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='city']" position="attributes">
                <attribute name="widget">kw_autocomplete</attribute>
                <attribute name="options">{
                    'source_type': 'model_method',
                    'source_config': {
                        'model': 'geodata.api.credential',
                        'method': 'kw_autocomplete_cities'
                    },
                    'depends_on': ['country_id'],
                    'on_select_method': 'apply_address_to_partner',
                    'min_chars': 3
                }</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='state_id']" position="after">
                <field name="area" placeholder="District/Raion"
                       readonly="1" force_save="1"
                       invisible="country_code != 'UA'"/>
                <field name="hromada" placeholder="Hromada"
                       readonly="1" force_save="1"
                       invisible="country_code != 'UA'"/>
            </xpath>

            <notebook position="inside">
                <page name="geodata_page" string="Address Information">
                    <div class="alert alert-warning" role="alert"
                         invisible="has_geodata_credential">
                        <strong>Geodata.online not configured</strong>
                        <br/>
                        Configure Geodata API credentials in Settings to enable
                        address autocomplete.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="country_code == 'UA' or not has_geodata_credential">
                        <strong>To enable address suggestions, select country: Ukraine</strong>
                    </div>
                    <div class="border border-primary rounded p-2 mb-2"
                         invisible="country_code != 'UA'">
                        <group>
                            <field name="geodata_search"
                                   widget="kw_autocomplete"
                                   placeholder="Search Address (Region, City, Street, House)..."
                                   options="{
                                       'source_type': 'model_method',
                                       'source_config': {
                                           'model': 'geodata.api.credential',
                                           'method': 'kw_autocomplete_full_address'
                                       },
                                       'on_select_method': 'apply_address_to_partner',
                                       'min_chars': 3
                                   }"
                                   class="oe_edit_only"
                                   colspan="2"/>
                        </group>
                    </div>
                    <div>Step-by-step address search and automatic address data filling</div>
                    <group invisible="not has_geodata_credential" string="Address details">
                        <field name="geodata_address_id" readonly="1"
                               force_save="1"
                               title="View address details"/>
                        <field name="geodata_kato" string="KATOTTG"
                               widget="CopyClipboardChar"/>
                        <field name="geodata_koatuu" string="KOATUU"
                               widget="CopyClipboardChar"/>
                        <field name="geodata_terr_status" string="Territory Status"
                               invisible="not geodata_terr_status"/>
                        <field name="geodata_address_updated" string="Address Updated"
                               invisible="not geodata_address_id"/>
                    </group>
                    <group invisible="not has_geodata_credential"
                           string="Full Addresses for Documents"
                           name="contract_addresses">
                        <field name="geodata_address_full_ua"
                               string="UA" widget="CopyClipboardChar"/>
                        <field name="geodata_address_full_ru"
                               string="RU" widget="CopyClipboardChar"
                               invisible="not geodata_store_russian"/>
                        <field name="geodata_address_full_en"
                               string="EN" widget="CopyClipboardChar"
                               invisible="not geodata_store_english"/>
                    </group>
                    <group invisible="not has_geodata_credential"
                           string="Full Addresses for Letters"
                           name="letter_addresses">
                        <field name="geodata_address_letter_ua"
                               string="UA" widget="CopyClipboardChar"/>
                        <field name="geodata_address_letter_ru"
                               string="RU" widget="CopyClipboardChar"
                               invisible="not geodata_store_russian"/>
                        <field name="geodata_address_letter_en"
                               string="EN" widget="CopyClipboardChar"
                               invisible="not geodata_store_english"/>
                    </group>
                    <div class="text-muted mt-3" invisible="not has_geodata_credential">
                        <a href="https://geodata.online" target="_blank"
                           class="text-primary">
                            GEODATA.online
                        - address normalization and validation service for Ukraine
                        </a>
                    </div>
                </page>
            </notebook>

        </field>
    </record>
</odoo>
